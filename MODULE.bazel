"""KubeVirt Bazel Module Configuration"""

module(
    name = "kubevirt",
    version = "0.0.0",
)

# ============================================================================
# Bazel rules dependencies
# ============================================================================

# platforms - must be loaded early
bazel_dep(name = "platforms", version = "1.0.0")

# rules_oci for container images
bazel_dep(name = "rules_oci", version = "2.0.1")

# Buildifier for formatting
bazel_dep(name = "buildifier_prebuilt", version = "7.3.1")

# Go rules - using repo name rules_go as expected by rules_go
bazel_dep(name = "rules_go", version = "0.54.1", repo_name = "io_bazel_rules_go")

# Gazelle for BUILD file generation
bazel_dep(name = "gazelle", version = "0.39.1", repo_name = "bazel_gazelle")

# Package rules
bazel_dep(name = "rules_pkg", version = "1.0.1")

# Distroless rules for container images
bazel_dep(name = "rules_distroless", version = "0.4.2")

# bazel_skylib for common utilities
bazel_dep(name = "bazel_skylib", version = "1.7.1")

# Protobuf (required by rules_go)
bazel_dep(name = "protobuf", version = "29.3")

# ============================================================================
# Go SDK and dependencies configuration
# ============================================================================

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.24.9")
go_sdk.nogo(nogo = "//:nogo_vet")

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# All direct Go dependencies from go.mod
# Note: These repo names follow gazelle's naming convention
# The replace directives in go.mod (for kubevirt.io/api and kubevirt.io/client-go
# pointing to staging directories, and various k8s.io overrides) are handled
# automatically by gazelle's go_deps extension.
use_repo(
    go_deps,
    "cat_dario_mergo",
