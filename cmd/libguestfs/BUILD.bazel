load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//:pkg.bzl", "pkg_tar")

pkg_tar(
    name = "entrypoint",
    srcs = ["entrypoint.sh"],
    mode = "0775",
    package_dir = "/",
)

# Create done file. This was used in the previous version of the image to understand when the appliance was extracted.
genrule(
    name = "done-file",
    outs = ["done"],
    cmd = "touch $@",
)

pkg_tar(
    name = "version",
    srcs = [
        "//:get-version",
    ],
    package_dir = "/",
)

pkg_tar(
    name = "appliance_layer_x86_64",
    srcs = [
        ":done-file",
        "@libguestfs-appliance-x86_64//appliance:README.fixed",
        "@libguestfs-appliance-x86_64//appliance:initrd",
        "@libguestfs-appliance-x86_64//appliance:kernel",
        "@libguestfs-appliance-x86_64//appliance:root",
    ],
    mode = "0444",
    package_dir = "/usr/local/lib/guestfs/appliance",
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "appliance_layer_s390x",
    srcs = [
        ":done-file",
        "@libguestfs-appliance-s390x//appliance:README.fixed",
        "@libguestfs-appliance-s390x//appliance:initrd",
        "@libguestfs-appliance-s390x//appliance:kernel",
        "@libguestfs-appliance-s390x//appliance:root",
    ],
    mode = "0444",
    package_dir = "/usr/local/lib/guestfs/appliance",
    visibility = ["//visibility:public"],
)

alias(
    name = "appliance_layer",
    actual = select({
        "@io_bazel_rules_go//go/platform:linux_s390x": ":appliance_layer_s390x",
        "//conditions:default": ":appliance_layer_x86_64",
    }),
)

oci_image(
    name = "libguestfs-tools-image",
    base = "//bazel/compat:go_image_base",
    user = "1001",
    entrypoint = ["/entrypoint.sh"],
    tars = [
        "//bazel/compat:libguestfs-tools",
        ":appliance_layer",
        "//:passwd-tar",
        ":version",
    ],
)

oci_push(
    name = "push",
    image = ":libguestfs-tools-image",
    repository = "quay.io/kubevirt/libguestfs-tools",
    visibility = ["//visibility:public"],
)

oci_load(
    name = "load",
    image = ":libguestfs-tools-image",
    repo_tags = ["bazel/libguestfs-tools:latest"],
)
