# WORKSPACE.bzlmod - Legacy dependencies that cannot be migrated to MODULE.bazel
#
# This file contains dependencies that need to remain in WORKSPACE format:
# - http_file dependencies (disk images, RPMs)
# - http_archive dependencies not available as Bazel modules
# - go_repository dependencies that require specific commit pinning
# - RPM package definitions via bazeldnf

workspace(name = "kubevirt")

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive", "http_file")

# ============================================================================
# bazeldnf - not available in BCR, load from archive
# ============================================================================

http_archive(
    name = "bazeldnf",
    sha256 = "0a4b9740da1839ded674c8f5012c069b235b101f1eaa2552a4721287808541af",
    strip_prefix = "bazeldnf-v0.5.9-2",
    urls = [
        "https://github.com/brianmcarey/bazeldnf/releases/download/v0.5.9-2/bazeldnf-v0.5.9-2.tar.gz",
        "https://storage.googleapis.com/builddeps/0a4b9740da1839ded674c8f5012c069b235b101f1eaa2552a4721287808541af",
    ],
)

load(
    "@bazeldnf//bazeldnf:repositories.bzl",
    "bazeldnf_dependencies",
    "bazeldnf_register_toolchains",
)

bazeldnf_dependencies()

bazeldnf_register_toolchains(
    name = "bazeldnf_prebuilt",
)

# ============================================================================
# Container RPM rules
