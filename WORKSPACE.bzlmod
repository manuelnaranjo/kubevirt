# ============================================================================
# RPM packages - loaded via bazeldnf
# The RPM definitions are extensive (873 packages). They are loaded from
# a separate file to keep this WORKSPACE clean.
# ============================================================================

load("@bazeldnf//bazeldnf:defs.bzl", "rpm")

# Load all RPM definitions from a separate file
load("//bazel:rpm_deps.bzl", "rpm_dependencies")

rpm_dependencies()
